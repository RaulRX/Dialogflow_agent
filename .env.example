# Dialogflow ES
DIALOGFLOW_PROJECT_ID=your-gcp-project-id
DIALOGFLOW_LANGUAGE=es
# Clave JSON de la cuenta de servicio (rol "Dialogflow API Client"); guardala en secrets/
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Dialogflow corta el webhook a los 5 s: el timeout debe quedar por debajo
LLM_TIMEOUT_SECONDS=4
# 0 = respuestas deterministas, las que menos se inventan
LLM_TEMPERATURE=0
# Razonamiento interno de Gemini 3.x: minimal | low | medium 
# | high (menos nivel = menos latencia)
LLM_THINKING_LEVEL=low

# Acciones (campo Action) de las intenciones del agente de Dialogflow. Si renombras una en la
# consola, cambia aqui su valor. Deben ser todas distintas.
ACTION_BOOKING_REQUEST=cita.pedir
ACTION_BOOKING_CONFIRM=cita.pedir.si
ACTION_BOOKING_LOOKUP=cita.consultar
ACTION_EMERGENCY=cita.urgencia
ACTION_LEAFLET=prospecto.consultar
ACTION_LEAFLET_FOLLOWUP=prospecto.seguimiento
ACTION_CARE=cuidados.consultar
ACTION_CARE_FOLLOWUP=cuidados.seguimiento
ACTION_FALLBACK=input.unknown
ACTION_CLINIC=clinica.info

# Base documental generada por el pipeline OCR
KNOWLEDGE_BASE_PATH=ocr/data/knowledge_base.json
