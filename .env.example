# Dialogflow ES
DIALOGFLOW_PROJECT_ID=your-gcp-project-id
DIALOGFLOW_LANGUAGE=es
# Clave JSON de la cuenta de servicio (rol "Dialogflow API Client"); guardala en secrets/
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=3.5

# Base documental generada por el pipeline OCR
KNOWLEDGE_BASE_PATH=ocr/data/knowledge_base.json
